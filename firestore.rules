rules_version = '2';

// Reglas de seguridad PyME-Sync — matriz RBAC del documento de diseño.
//
// Roles: el documento users/{uid} tiene role: 'admin' | 'operator'.
// - Admin:    CRUD completo de catálogos, usuarios y cancelación de folios.
// - Operador: consulta catálogos, da de alta productos nuevos, registra
//             movimientos y ventas (solo puede modificar stock en
//             productos existentes, nunca precios ni catálogo).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'admin';
    }

    // Solo cambió el campo stock (ajustes del operador por venta/movimiento).
    function onlyStockChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stock']);
    }

    // Campos que cada quien puede editar de su propio perfil desde
    // Configuración. Deja fuera `role` y `active` a propósito: el rol y la
    // baja son del administrador.
    //
    // `email` se admite solo para copiar el correo que Firebase Auth ya
    // verificó (cuando alguien convierte su correo de recuperación en el
    // de la cuenta). Al exigir que coincida con el del token, el perfil no
    // puede quedar apuntando a un correo que no sea el de la sesión.
    function onlyOwnProfileFieldsChanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['name', 'recoveryEmail', 'startSection', 'email'])
        && (!changed.hasAny(['email'])
            || request.resource.data.email == request.auth.token.email);
    }

    match /users/{userId} {
      // Cada quien lee su perfil; el admin lee y administra todos.
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // Primer login: el usuario crea su propio perfil como operador.
      allow create: if isAdmin()
        || (signedIn()
            && request.auth.uid == userId
            && request.resource.data.role == 'operator');
      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == userId
            && onlyOwnProfileFieldsChanged());
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      // Operador: alta de productos; en existentes solo ajuste de stock.
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && onlyStockChanged());
      allow delete: if isAdmin();
    }

    match /movements/{movementId} {
      allow read: if signedIn();
      // Bitácora de auditoría: se crea pero no se edita ni borra.
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /sales/{saleId} {
      allow read: if signedIn();
      allow create: if signedIn();
      // Cancelación de folios: solo Admin y solo el campo cancelled.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['cancelled']);
      allow delete: if false;
    }

    match /meta/{docId} {
      // Contador de folios: lo actualiza la transacción de venta.
      allow read, write: if signedIn();
    }

    match /sessions/{sessionId} {
      // Cualquier usuario firmado lee todas: el admin necesita ver las
      // horas conectadas del equipo completo en Usuarios, igual que ya
      // puede leer todos los movimientos y ventas.
      allow read: if signedIn();
      // Cada quien solo abre y actualiza SU propia sesión (AuthService al
      // iniciar/cerrar sesión y en el heartbeat periódico), y solo puede
      // tocar los campos de seguimiento — nunca reescribir a quién
      // pertenece la sesión.
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastSeenAt', 'endedAt']);
      allow delete: if false;
    }
  }
}
